FROM node:24-alpine

WORKDIR /frontend

# Copy package files first for better caching
COPY package*.json ./
RUN npm install

# Copy the rest of the files
COPY . .

# Mount source code in docker-compose for live reload

EXPOSE 5173

# Run Vite in development mode
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]