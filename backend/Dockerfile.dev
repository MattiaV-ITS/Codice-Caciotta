FROM mcr.microsoft.com/openjdk/jdk:21-ubuntu

WORKDIR /backend

# Install Maven (if not using mvnw)
RUN apt-get update && apt-get install -y maven

# Copy only necessary files for dependency resolution
COPY pom.xml .
COPY .mvn .mvn
COPY mvnw .

# Download dependencies
RUN ./mvnw dependency:go-offline

# Copy source code
COPY src src

# Expose debug port for remote debugging (optional)
EXPOSE 8080 5005

# Mount source code as volume in docker-compose (see next step)

# Run Spring Boot with devtools enabled and remote debug
CMD ["./mvnw", "spring-boot:run", "-Dspring-boot.run.fork=false", "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"]
