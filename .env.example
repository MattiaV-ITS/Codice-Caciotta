# Questo è un file di esempio per le variabili d'ambiente. Copialo in un nuovo file chiamato .env e modifica i valori

# Account PostgreSQL
POSTGRESDB_USER=codicecaciotta
POSTGRESDB_ROOT_PASSWORD=123456

POSTGRESDB_DATABASE=vet

POSTGRESDB_LOCAL_PORT=5433
POSTGRESDB_DOCKER_PORT=5432

# Spring Boot
SPRING_LOCAL_PORT=6868
SPRING_DOCKER_PORT=8080

# 64 chars chiave segreta per la generazione dei token JWT
APP_JWT_SECRET=================CodiceCaciotta=Spring===========================

# Per bypassare la sicurezza (solo per test, non usare in produzione)
DEV_MODE=true